# GNN-FraudNet Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── LLM ──────────────────────────────────────────────────────
# Google Gemini API key (free from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use for report generation
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# ── Model Paths ──────────────────────────────────────────────
MODEL_PATH=results/best_graphsage.pt
DATA_PATH=data/processed/elliptic_graph.pt

# ── RAG ──────────────────────────────────────────────────────
CHROMA_DB_PATH=knowledge_base/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# ── App ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
